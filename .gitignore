# Build output: keep the bundled runtime DLLs tracked
/Debug/*
!/Debug/freeglut.dll
!/Debug/glew32.dll
/Release/*
!/Release/freeglut.dll
!/Release/glew32.dll
/x64/Debug/*
!/x64/Debug/freeglut.dll
!/x64/Debug/glew32.dll
/x64/Release/*
!/x64/Release/freeglut.dll
!/x64/Release/glew32.dll
