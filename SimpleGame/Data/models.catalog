model Potion static Models/Potion.model
model Fragment static Models/Fragment.model
model Crawler creature Models/Crawler.model
model BrokenWall static Models/BrokenWall.model
model Arch static Models/Arch.model
model Statue static Models/Statue.model
model Grave static Models/Grave.model
model Cart static Models/Cart.model
model FungalColony static Models/FungalColony.model
model Debris static Models/Debris.model
model Corpse static Models/Corpse.model
model Fence static Models/Fence.model
model DeadTree static Models/DeadTree.model
model BlightedTree static Models/BlightedTree.model
